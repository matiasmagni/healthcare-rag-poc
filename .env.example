UNSLOTH_BASE_URL=http://localhost:8888/v1
UNSLOTH_API_KEY=sk-your-unsloth-api-key
UNSLOTH_MODEL=unsloth/gemma-3-4b-it-GGUF:BF16
UNSLOTH_EVAL_MODEL=unsloth/gemma-3-4b-it-GGUF:BF16
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_ENABLE_THINKING=false
LLM_MAX_COMPLETION_TOKENS=4096

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
RETRIEVAL_K=4

CHUNK_SIZE=500
CHUNK_OVERLAP=50

PDF_SUBDIR=input-docs
PDF_FILENAMES=HIPAA-Clinician-inside.pdf,privacysummary.pdf,pocket-guide.pdf
INDEX_DIR_NAME=faiss_index
LOG_LEVEL=INFO

# Ragas thresholds
RAGAS_FAITHFULNESS_THRESHOLD=0.85
RAGAS_ANSWER_RELEVANCE_THRESHOLD=0.85
RAGAS_CONTEXT_PRECISION_THRESHOLD=0.0
RAGAS_CONTEXT_RECALL_THRESHOLD=0.0

# Ragas run config
RAGAS_RUN_CONFIG_TIMEOUT=1200
RAGAS_RUN_CONFIG_MAX_WORKERS=1
RAGAS_REPORT_PATH=tests/reports/ragas_report.html

# Ragas RunConfig
RAGAS_TIMEOUT=1200
RAGAS_MAX_WORKERS=1
